{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git": "allow",
      "git *": "allow",
      "cargo": "allow",
      "cargo *": "allow",
      "yarn": "allow",
      "yarn *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "find": "allow",
      "find *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "glab": "allow",
      "glab *": "allow"
    },
    "external_directory": {
      "/home/marcel/dev/**": "allow",
      "/home/marcel/dotfiles/**": "allow"
    },
    "read": {
      "/home/marcel/dev/**": "allow",
      "/home/marcel/dotfiles/**": "allow"
    },
    "edit": {
      "/home/marcel/dev/**": "allow",
      "/home/marcel/dotfiles/**": "allow"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*": "ask",
          "/home/marcel/dev/**": "allow",
          "/home/marcel/dotfiles/**": "allow"
        }
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    }
  },
  "instructions": [
    "./instructions/git.md"
  ]
}

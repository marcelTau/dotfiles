_git_branch() {
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || \
  branch=$(git rev-parse --short HEAD 2>/dev/null) || return
  echo " %F{green}$branch%f"
}

_aws_env() {
  [[ -n "$AWS_VAULT" ]] && echo " %F{208}[aws:$AWS_VAULT]%f"
}

setopt PROMPT_SUBST
PROMPT='%F{blue}%~%f$(_git_branch)$(_aws_env) %F{white}$%f '
